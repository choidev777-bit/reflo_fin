{
  "name": "reflo-research-workspace",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose -f ../infra/local/compose.yaml up -d --build --wait",
    "db:down": "docker compose -f ../infra/local/compose.yaml down",
    "db:migrate": "node --env-file=.env.development.local ./node_modules/node-pg-migrate/bin/node-pg-migrate.js -d REFLO_DATABASE_URL -m ../infra/migrations -j ts -t reflo_migrations up",
    "db:rollback": "node --env-file=.env.development.local ./node_modules/node-pg-migrate/bin/node-pg-migrate.js -d REFLO_DATABASE_URL -m ../infra/migrations -j ts -t reflo_migrations down",
    "worker:control": "tsx workers/control/run.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@temporalio/client": "^1.21.1",
    "@temporalio/worker": "^1.21.1",
    "@temporalio/workflow": "^1.21.1",
    "decimal.js": "10.6.0",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "16.2.6",
    "ogl": "^1.0.11",
    "openid-client": "6.8.4",
    "pg": "8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "^3.4.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "node-pg-migrate": "9.0.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "REFLO Research Workspace"
}
