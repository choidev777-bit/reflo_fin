{
  "name": "reflo-research-workspace",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "next build",
    "start": "next start",
    "compose:local": "node scripts/compose-local.mjs",
    "db:up": "node scripts/compose-local.mjs up -d --build --wait",
    "db:down": "node scripts/compose-local.mjs down",
    "db:migrate": "node scripts/db-migrate.mjs up",
    "db:rollback": "node scripts/db-migrate.mjs down",
    "temporal:e2e:namespace": "node scripts/ensure-temporal-namespace.mjs",
    "worker:control": "tsx workers/control/run.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && node --import tsx --test tests/*.test.ts",
    "test:e2e:prepare": "node scripts/prepare-e2e-runtime.mjs",
    "test:e2e": "npm run test:e2e:prepare && playwright test",
    "test:e2e:update": "npm run test:e2e:prepare && playwright test --update-snapshots",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@temporalio/client": "^1.21.1",
    "@temporalio/worker": "^1.21.1",
    "@temporalio/workflow": "^1.21.1",
    "@tiptap/core": "3.29.0",
    "@tiptap/react": "3.29.0",
    "@tiptap/starter-kit": "3.29.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "decimal.js": "10.6.0",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "16.2.6",
    "ogl": "^1.0.11",
    "openid-client": "6.8.4",
    "pdfjs-dist": "6.1.200",
    "pg": "8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "^3.4.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "node-pg-migrate": "9.0.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "REFLO Research Workspace"
}
