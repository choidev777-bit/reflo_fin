# 시연 영상 촬영용 고정 응답 모드. 자세한 내용은
# docs/runbooks/REFLO_DEMO_MODE.md 참고.
# 1이면 STEP 03·04·07의 AI 호출을 고정 시나리오로 대체하고 단계마다 지연을
# 넣는다. AI를 쓰지 않는 기능(파일 검사, Excel 계산, 내보내기)은 그대로 동작한다.
REFLO_DEMO_MODE=0
REFLO_DEMO_HYPOTHESIS_SECONDS=5
REFLO_DEMO_RESEARCH_SECONDS=15
REFLO_DEMO_OUTLINE_SECONDS=6
REFLO_DEMO_DRAFT_SECONDS=10
