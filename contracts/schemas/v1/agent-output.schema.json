{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reflo.dev/worker/v1/agent-output.schema.json",
  "title": "REFLO Agent Structured Output v1",
  "description": "PydanticAI-validated proposal output. Agent output never constitutes approval, Evidence, or authoritative calculation.",
  "oneOf": [
    {
      "$ref": "#/$defs/HypothesisQuestionOutput"
    },
    {
      "$ref": "#/$defs/ValuationProposalOutput"
    },
    {
      "$ref": "#/$defs/ReportOutlineProposalOutput"
    },
    {
      "$ref": "#/$defs/ReportTextProposalOutput"
    }
  ],
  "$defs": {
    "AgentMetadata": {
      "title": "AgentMetadata",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "promptVersion",
        "outputSchemaId",
        "startedAt",
        "finishedAt",
        "usage"
      ],
      "properties": {
        "provider": {
          "const": "openai"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "outputSchemaId": {
          "const": "https://schemas.reflo.dev/worker/v1/agent-output.schema.json"
        },
        "startedAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "finishedAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputTokens",
            "outputTokens"
          ],
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "cachedInputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "reasoningTokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "AgentRoot": {
      "title": "AgentRoot",
      "type": "object",
      "required": [
        "schemaVersion",
        "outputType",
        "inputVersionRefs",
        "metadata",
        "warnings"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "common.schema.json#/$defs/SchemaVersion"
        },
        "outputType": {
          "type": "string"
        },
        "inputVersionRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/ResourceVersionRef"
          }
        },
        "metadata": {
          "$ref": "#/$defs/AgentMetadata"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Warning"
          }
        }
      }
    },
    "ResearchQuestionProposal": {
      "title": "ResearchQuestionProposal",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionKey",
        "text",
        "purpose",
        "metrics",
        "period",
        "comparison",
        "sourceTypes",
        "priority"
      ],
      "properties": {
        "questionKey": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "period": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "comparison": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "sourceTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "filing",
              "company",
              "news",
              "industry",
              "market_data"
            ]
          }
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "HypothesisQuestionOutput": {
      "title": "HypothesisQuestionOutput",
      "allOf": [
        {
          "$ref": "#/$defs/AgentRoot"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "outputType",
            "inputVersionRefs",
            "metadata",
            "warnings",
            "questions",
            "missingContext"
          ],
          "properties": {
            "schemaVersion": {
              "$ref": "common.schema.json#/$defs/SchemaVersion"
            },
            "outputType": {
              "const": "hypothesis_questions"
            },
            "inputVersionRefs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common.schema.json#/$defs/ResourceVersionRef"
              }
            },
            "metadata": {
              "$ref": "#/$defs/AgentMetadata"
            },
            "warnings": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/Warning"
              }
            },
            "questions": {
              "type": "array",
              "minItems": 3,
              "maxItems": 5,
              "items": {
                "$ref": "#/$defs/ResearchQuestionProposal"
              }
            },
            "missingContext": {
              "type": "array",
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        }
      ]
    },
    "ValuationProposalOutput": {
      "title": "ValuationProposalOutput",
      "allOf": [
        {
          "$ref": "#/$defs/AgentRoot"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "outputType",
            "inputVersionRefs",
            "metadata",
            "warnings",
            "suggestedTargetPer",
            "rationale",
            "evidenceVersionIds",
            "assumptions"
          ],
          "properties": {
            "schemaVersion": {
              "$ref": "common.schema.json#/$defs/SchemaVersion"
            },
            "outputType": {
              "const": "valuation_proposal"
            },
            "inputVersionRefs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common.schema.json#/$defs/ResourceVersionRef"
              }
            },
            "metadata": {
              "$ref": "#/$defs/AgentMetadata"
            },
            "warnings": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/Warning"
              }
            },
            "suggestedTargetPer": {
              "$ref": "common.schema.json#/$defs/DecimalString"
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "evidenceVersionIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/OpaqueId"
              }
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      ]
    },
    "OutlineSlotProposal": {
      "title": "OutlineSlotProposal",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotId",
        "value",
        "evidenceVersionIds"
      ],
      "properties": {
        "slotId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 20000
            },
            {
              "$ref": "common.schema.json#/$defs/DecimalString"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "evidenceVersionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/OpaqueId"
          }
        }
      }
    },
    "OutlinePageProposal": {
      "title": "OutlinePageProposal",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageId",
        "slotProposals"
      ],
      "properties": {
        "pageId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "slotProposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutlineSlotProposal"
          }
        }
      }
    },
    "ReportOutlineProposalOutput": {
      "title": "ReportOutlineProposalOutput",
      "allOf": [
        {
          "$ref": "#/$defs/AgentRoot"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "outputType",
            "inputVersionRefs",
            "metadata",
            "warnings",
            "pages"
          ],
          "properties": {
            "schemaVersion": {
              "$ref": "common.schema.json#/$defs/SchemaVersion"
            },
            "outputType": {
              "const": "report_outline_proposal"
            },
            "inputVersionRefs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common.schema.json#/$defs/ResourceVersionRef"
              }
            },
            "metadata": {
              "$ref": "#/$defs/AgentMetadata"
            },
            "warnings": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/Warning"
              }
            },
            "pages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/OutlinePageProposal"
              }
            }
          }
        }
      ]
    },
    "TextReplacementProposal": {
      "title": "TextReplacementProposal",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockId",
        "baseBlockRevision",
        "replacementText",
        "evidenceVersionIds"
      ],
      "properties": {
        "blockId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "baseBlockRevision": {
          "$ref": "common.schema.json#/$defs/VersionNumber"
        },
        "replacementText": {
          "type": "string",
          "maxLength": 20000
        },
        "evidenceVersionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/OpaqueId"
          }
        }
      }
    },
    "PreservationCheck": {
      "title": "PreservationCheck",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numbers",
        "evidence",
        "rating",
        "userAssumptions"
      ],
      "properties": {
        "numbers": {
          "type": "boolean",
          "const": true
        },
        "evidence": {
          "type": "boolean",
          "const": true
        },
        "rating": {
          "type": "boolean",
          "const": true
        },
        "userAssumptions": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "ReportTextProposalOutput": {
      "title": "ReportTextProposalOutput",
      "allOf": [
        {
          "$ref": "#/$defs/AgentRoot"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "outputType",
            "inputVersionRefs",
            "metadata",
            "warnings",
            "baseReportVersionId",
            "operations",
            "preservationCheck"
          ],
          "properties": {
            "schemaVersion": {
              "$ref": "common.schema.json#/$defs/SchemaVersion"
            },
            "outputType": {
              "const": "report_text_proposal"
            },
            "inputVersionRefs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common.schema.json#/$defs/ResourceVersionRef"
              }
            },
            "metadata": {
              "$ref": "#/$defs/AgentMetadata"
            },
            "warnings": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/Warning"
              }
            },
            "baseReportVersionId": {
              "$ref": "common.schema.json#/$defs/OpaqueId"
            },
            "operations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/TextReplacementProposal"
              }
            },
            "preservationCheck": {
              "$ref": "#/$defs/PreservationCheck"
            }
          }
        }
      ]
    }
  }
}
