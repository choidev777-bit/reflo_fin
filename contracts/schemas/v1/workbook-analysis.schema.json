{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reflo.dev/worker/v1/workbook-analysis.schema.json",
  "title": "REFLO Workbook Analysis v1",
  "description": "Immutable workbook structure and editable-cell analysis generated by the Excel worker.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workbookAnalysisId",
    "workbookVersionId",
    "fileHash",
    "structureHash",
    "format",
    "calculationStatus",
    "sheets",
    "editableCells",
    "externalLinks",
    "warnings",
    "tool"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "workbookAnalysisId": {
      "$ref": "common.schema.json#/$defs/OpaqueId"
    },
    "workbookVersionId": {
      "$ref": "common.schema.json#/$defs/OpaqueId"
    },
    "fileHash": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "structureHash": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "format": {
      "type": "string",
      "enum": [
        "xlsx",
        "xlsm"
      ]
    },
    "calculationStatus": {
      "type": "string",
      "enum": [
        "compatible",
        "compatible_with_warnings",
        "manual_review",
        "unsupported"
      ]
    },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/SheetAnalysis"
      }
    },
    "editableCells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EditableCell"
      }
    },
    "externalLinks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExternalLink"
      }
    },
    "namedRanges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NamedRange"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Warning"
      }
    },
    "tool": {
      "$ref": "common.schema.json#/$defs/ToolDescriptor"
    }
  },
  "$defs": {
    "SheetAnalysis": {
      "title": "SheetAnalysis",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheetId",
        "name",
        "index",
        "visibility",
        "usedRange",
        "structureHash",
        "formulaCount",
        "mergedRangeCount",
        "chartCount",
        "tableCount"
      ],
      "properties": {
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "visibility": {
          "type": "string",
          "enum": [
            "visible",
            "hidden",
            "very_hidden"
          ]
        },
        "usedRange": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*:[A-Za-z]{1,3}[1-9][0-9]*$"
        },
        "structureHash": {
          "$ref": "common.schema.json#/$defs/Sha256"
        },
        "formulaCount": {
          "type": "integer",
          "minimum": 0
        },
        "mergedRangeCount": {
          "type": "integer",
          "minimum": 0
        },
        "chartCount": {
          "type": "integer",
          "minimum": 0
        },
        "tableCount": {
          "type": "integer",
          "minimum": 0
        },
        "protected": {
          "type": "boolean"
        }
      }
    },
    "EditableCell": {
      "title": "EditableCell",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheetId",
        "sheetName",
        "address",
        "classification",
        "styleFingerprint",
        "required"
      ],
      "properties": {
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sheetName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "address": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*$"
        },
        "classification": {
          "type": "string",
          "enum": [
            "user_input",
            "formula",
            "verified_actual",
            "system_bridge",
            "protected"
          ]
        },
        "styleFingerprint": {
          "$ref": "common.schema.json#/$defs/Sha256"
        },
        "numberFormat": {
          "type": "string",
          "maxLength": 500
        },
        "valueType": {
          "type": "string",
          "enum": [
            "decimal",
            "string",
            "boolean",
            "date",
            "blank"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "ExternalLink": {
      "title": "ExternalLink",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "status"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": [
            "resolved",
            "cached_only",
            "blocked",
            "missing"
          ]
        },
        "affectedCells": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "NamedRange": {
      "title": "NamedRange",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "refersTo",
        "scope"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "refersTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "scope": {
          "type": "string",
          "enum": [
            "workbook",
            "worksheet"
          ]
        },
        "sheetId": {
          "type": "string",
          "maxLength": 100
        }
      }
    }
  }
}
