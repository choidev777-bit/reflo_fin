{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reflo.dev/worker/v1/workbook-analysis.schema.json",
  "title": "REFLO Workbook Analysis v1",
  "description": "Immutable workbook structure and editable-cell analysis generated by the Excel worker.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workbookAnalysisId",
    "workbookVersionId",
    "fileHash",
    "structureHash",
    "format",
    "calculationStatus",
    "sheets",
    "editableCells",
    "candidateCells",
    "candidateRanges",
    "externalLinks",
    "warnings",
    "tool"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "workbookAnalysisId": {
      "$ref": "common.schema.json#/$defs/OpaqueId"
    },
    "workbookVersionId": {
      "$ref": "common.schema.json#/$defs/OpaqueId"
    },
    "fileHash": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "structureHash": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "format": {
      "type": "string",
      "enum": [
        "xlsx",
        "xlsm"
      ]
    },
    "calculationStatus": {
      "type": "string",
      "enum": [
        "compatible",
        "compatible_with_warnings",
        "manual_review",
        "unsupported"
      ]
    },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/SheetAnalysis"
      }
    },
    "editableCells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EditableCell"
      }
    },
    "candidateCells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CandidateCell"
      }
    },
    "candidateRanges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CandidateRange"
      }
    },
    "charts": {
      "description": "OOXML chart definitions resolved through worksheet and drawing relationships.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ChartAnalysis"
      }
    },
    "externalLinks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExternalLink"
      }
    },
    "namedRanges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NamedRange"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Warning"
      }
    },
    "calculationErrors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CalculationError"
      }
    },
    "functions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9._]*$",
        "maxLength": 100
      }
    },
    "tool": {
      "$ref": "common.schema.json#/$defs/ToolDescriptor"
    }
  },
  "$defs": {
    "SheetAnalysis": {
      "title": "SheetAnalysis",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheetId",
        "name",
        "index",
        "visibility",
        "usedRange",
        "structureHash",
        "formulaCount",
        "mergedRangeCount",
        "chartCount",
        "tableCount"
      ],
      "properties": {
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "ooxmlSheetId": {
          "description": "The persistent sheetId attribute from xl/workbook.xml.",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "relationshipId": {
          "description": "Workbook relationship id that resolves this worksheet part.",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "partPath": {
          "description": "Normalized OOXML worksheet part path.",
          "type": "string",
          "pattern": "^xl/worksheets/[^/]+\\.xml$",
          "maxLength": 500
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "visibility": {
          "type": "string",
          "enum": [
            "visible",
            "hidden",
            "very_hidden"
          ]
        },
        "usedRange": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*:[A-Za-z]{1,3}[1-9][0-9]*$"
        },
        "structureHash": {
          "$ref": "common.schema.json#/$defs/Sha256"
        },
        "formulaCount": {
          "type": "integer",
          "minimum": 0
        },
        "mergedRangeCount": {
          "type": "integer",
          "minimum": 0
        },
        "chartCount": {
          "type": "integer",
          "minimum": 0
        },
        "tableCount": {
          "type": "integer",
          "minimum": 0
        },
        "protected": {
          "type": "boolean"
        }
      }
    },
    "EditableCell": {
      "title": "EditableCell",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheetId",
        "sheetName",
        "address",
        "classification",
        "styleFingerprint",
        "required"
      ],
      "properties": {
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sheetName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "address": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*$"
        },
        "classification": {
          "type": "string",
          "enum": [
            "user_input",
            "formula",
            "verified_actual",
            "system_bridge",
            "protected"
          ]
        },
        "styleFingerprint": {
          "$ref": "common.schema.json#/$defs/Sha256"
        },
        "numberFormat": {
          "type": "string",
          "maxLength": 500
        },
        "valueType": {
          "type": "string",
          "enum": [
            "decimal",
            "string",
            "boolean",
            "date",
            "blank"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "CandidateCell": {
      "title": "CandidateCell",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "sheetId",
        "sheetName",
        "address",
        "valueType",
        "displayValue",
        "numberFormat",
        "label",
        "formula",
        "styleFingerprint",
        "structureFingerprint"
      ],
      "properties": {
        "candidateId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sheetName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "address": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*$"
        },
        "valueType": {
          "type": "string",
          "enum": [
            "decimal",
            "string",
            "boolean",
            "date",
            "blank",
            "error"
          ]
        },
        "displayValue": {
          "type": "string",
          "maxLength": 2000
        },
        "rawValue": {},
        "numberFormat": {
          "type": "string",
          "maxLength": 500
        },
        "label": {
          "type": "string",
          "maxLength": 500
        },
        "formula": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 10000
        },
        "styleFingerprint": {
          "$ref": "common.schema.json#/$defs/Sha256"
        },
        "structureFingerprint": {
          "$ref": "common.schema.json#/$defs/Sha256"
        }
      }
    },
    "TableColumnRef": {
      "title": "TableColumnRef",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "column",
        "label"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,3}$"
        },
        "label": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "PeriodColumn": {
      "title": "PeriodColumn",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "column",
        "label",
        "role"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,3}$"
        },
        "label": {
          "type": "string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": [
            "actual",
            "forecast",
            "unknown"
          ]
        }
      }
    },
    "ChartAnalysis": {
      "title": "ChartAnalysis",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chartId",
        "sheetId",
        "sheetName",
        "partPath",
        "chartTypes",
        "series",
        "axes",
        "structureFingerprint"
      ],
      "properties": {
        "chartId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sheetName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "partPath": {
          "type": "string",
          "pattern": "^xl/(?:[^/]+/)*charts/[^/]+\\.xml$",
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "maxLength": 1000
        },
        "anchor": {
          "$ref": "#/$defs/ChartAnchor"
        },
        "chartTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,99}$"
          }
        },
        "category": {
          "oneOf": [
            {
              "$ref": "#/$defs/ChartDataReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartSeries"
          }
        },
        "axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartAxis"
          }
        },
        "structureFingerprint": {
          "$ref": "common.schema.json#/$defs/Sha256"
        }
      }
    },
    "ChartAnchor": {
      "title": "ChartAnchor",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "two_cell",
            "one_cell",
            "absolute",
            "unknown"
          ]
        },
        "fromCell": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*$"
        },
        "toCell": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*$"
        }
      }
    },
    "ChartDataReference": {
      "title": "ChartDataReference",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula",
        "cacheType",
        "pointCount",
        "cachedValues"
      ],
      "properties": {
        "formula": {
          "type": "string",
          "maxLength": 2000
        },
        "sheetId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "sheetName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "range": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*(?::[A-Za-z]{1,3}[1-9][0-9]*)?$"
        },
        "cacheType": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "none"
          ]
        },
        "pointCount": {
          "type": "integer",
          "minimum": 0
        },
        "cachedValues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChartCachedValue"
          }
        }
      }
    },
    "ChartCachedValue": {
      "title": "ChartCachedValue",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "value"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    },
    "ChartSeries": {
      "title": "ChartSeries",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seriesId",
        "index",
        "name",
        "chartType",
        "axis"
      ],
      "properties": {
        "seriesId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "maxLength": 1000
        },
        "nameFormula": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "chartType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,99}$"
        },
        "axis": {
          "type": "string",
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "category": {
          "oneOf": [
            {
              "$ref": "#/$defs/ChartDataReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "values": {
          "oneOf": [
            {
              "$ref": "#/$defs/ChartDataReference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ChartAxis": {
      "title": "ChartAxis",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axisId",
        "type",
        "position",
        "secondary"
      ],
      "properties": {
        "axisId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "enum": [
            "category",
            "date",
            "value",
            "series"
          ]
        },
        "position": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "top",
            "bottom",
            "unknown"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 1000
        },
        "numberFormat": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "crossAxisId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "secondary": {
          "type": "boolean"
        }
      }
    },
    "CandidateRange": {
      "title": "CandidateRange",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "sheetId",
        "sheetName",
        "range",
        "label",
        "rowCount",
        "columnCount",
        "structureFingerprint",
        "styleFingerprint",
        "mergedRanges",
        "columnDimensions",
        "rowDimensions",
        "presentationTruncated"
      ],
      "properties": {
        "candidateId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sheetName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "range": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*:[A-Za-z]{1,3}[1-9][0-9]*$"
        },
        "label": {
          "type": "string",
          "maxLength": 500
        },
        "rowCount": {
          "type": "integer",
          "minimum": 1
        },
        "columnCount": {
          "type": "integer",
          "minimum": 1
        },
        "structureFingerprint": {
          "$ref": "common.schema.json#/$defs/Sha256"
        },
        "styleFingerprint": {
          "$ref": "common.schema.json#/$defs/Sha256"
        },
        "mergedRanges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*:[A-Za-z]{1,3}[1-9][0-9]*$"
          }
        },
        "columnDimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RangeColumnDimension"
          }
        },
        "rowDimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RangeRowDimension"
          }
        },
        "presentationTruncated": {
          "type": "boolean"
        },
        "kind": {
          "description": "How this tabular range candidate was discovered.",
          "type": "string",
          "enum": [
            "excel_table",
            "dense_region",
            "used_range"
          ]
        },
        "headerRows": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "headerValues": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "rowKeyColumns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TableColumnRef"
          }
        },
        "periodColumns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PeriodColumn"
          }
        },
        "unitHints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "subtotalRows": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "RangeColumnDimension": {
      "title": "RangeColumnDimension",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "column",
        "widthPx"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,3}$"
        },
        "widthPx": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "RangeRowDimension": {
      "title": "RangeRowDimension",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "row",
        "heightPx"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "heightPx": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "CalculationError": {
      "title": "CalculationError",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheetName",
        "address",
        "code"
      ],
      "properties": {
        "sheetName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "address": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "ExternalLink": {
      "title": "ExternalLink",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "status"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": [
            "resolved",
            "cached_only",
            "blocked",
            "missing"
          ]
        },
        "affectedCells": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "NamedRange": {
      "title": "NamedRange",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "refersTo",
        "scope"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "refersTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "scope": {
          "type": "string",
          "enum": [
            "workbook",
            "worksheet"
          ]
        },
        "sheetId": {
          "type": "string",
          "maxLength": 100
        }
      }
    }
  }
}
