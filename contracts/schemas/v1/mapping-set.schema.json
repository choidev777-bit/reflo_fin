{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reflo.dev/worker/v1/mapping-set.schema.json",
  "title": "REFLO Mapping Set v1",
  "description": "Versioned typed mapping from workbook sources to stable Template IR slots.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mappingSetId",
    "mappingSetVersion",
    "templateId",
    "templateVersion",
    "workbookVersionId",
    "workbookFileHash",
    "workbookStructureHash",
    "analysisPipelineVersion",
    "semanticAliasVersion",
    "scoringRuleVersion",
    "status",
    "bindings",
    "candidates",
    "unmappedRequiredSlots",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "mappingSetId": {
      "$ref": "common.schema.json#/$defs/OpaqueId"
    },
    "mappingSetVersion": {
      "$ref": "common.schema.json#/$defs/VersionNumber"
    },
    "templateId": {
      "$ref": "common.schema.json#/$defs/OpaqueId"
    },
    "templateVersion": {
      "$ref": "common.schema.json#/$defs/VersionNumber"
    },
    "workbookVersionId": {
      "$ref": "common.schema.json#/$defs/OpaqueId"
    },
    "workbookFileHash": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "workbookStructureHash": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "analysisPipelineVersion": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]+/[0-9]+\\.[0-9]+$"
    },
    "semanticAliasVersion": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]+/[0-9]+\\.[0-9]+$"
    },
    "scoringRuleVersion": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]+/[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "suggested",
        "confirmed",
        "revalidation_required",
        "invalid"
      ]
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Binding"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MappingCandidate"
      }
    },
    "unmappedRequiredSlots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/OpaqueId"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Warning"
      }
    }
  },
  "$defs": {
    "MappingCandidate": {
      "title": "MappingCandidate",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "slotId",
        "kind",
        "source",
        "score",
        "reasonCodes",
        "selected"
      ],
      "properties": {
        "candidateId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "slotId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "cell",
            "range",
            "chart",
            "market_data"
          ]
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/CellSource"
            },
            {
              "$ref": "#/$defs/RangeSource"
            },
            {
              "$ref": "#/$defs/MarketDataSource"
            }
          ]
        },
        "chartDefinition": {
          "$ref": "#/$defs/ChartCandidateDefinition"
        },
        "bindingDefinition": {
          "$ref": "#/$defs/Binding"
        },
        "label": {
          "type": "string",
          "maxLength": 500
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,99}$"
          }
        },
        "selected": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "chart"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "chartDefinition": {
                "$ref": "#/$defs/ChartCandidateDefinition"
              }
            },
            "required": [
              "chartDefinition"
            ]
          }
        }
      ]
    },
    "CellSource": {
      "title": "CellSource",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheetId",
        "sheet",
        "address",
        "readMode",
        "authority",
        "structureFingerprint"
      ],
      "properties": {
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sheet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "address": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*$"
        },
        "readMode": {
          "const": "calculated_value"
        },
        "authority": {
          "type": "string",
          "enum": [
            "authoritative",
            "verification"
          ]
        },
        "formulaHash": {
          "$ref": "common.schema.json#/$defs/Sha256"
        },
        "numberFormat": {
          "type": "string",
          "maxLength": 500
        },
        "structureFingerprint": {
          "$ref": "common.schema.json#/$defs/Sha256"
        }
      }
    },
    "RangeSource": {
      "title": "RangeSource",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheetId",
        "sheet",
        "range",
        "authority",
        "structureFingerprint"
      ],
      "properties": {
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sheet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "range": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*:[A-Za-z]{1,3}[1-9][0-9]*$"
        },
        "authority": {
          "type": "string",
          "enum": [
            "authoritative",
            "verification"
          ]
        },
        "structureFingerprint": {
          "$ref": "common.schema.json#/$defs/Sha256"
        },
        "readMode": {
          "type": "string",
          "enum": [
            "raw",
            "formatted",
            "calculated_value",
            "raw_and_formatted"
          ]
        }
      }
    },
    "MarketDataSource": {
      "title": "MarketDataSource",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheetId",
        "sheet",
        "address",
        "authority",
        "structureFingerprint",
        "provider",
        "ticker",
        "exchange",
        "requestedDate",
        "tradingDate",
        "closePrice",
        "currency",
        "sourceApiId",
        "sourcePayloadHash"
      ],
      "properties": {
        "sheetId": {
          "const": "krx-open-api"
        },
        "sheet": {
          "const": "KRX"
        },
        "address": {
          "type": "string",
          "format": "date"
        },
        "authority": {
          "const": "authoritative"
        },
        "structureFingerprint": {
          "$ref": "common.schema.json#/$defs/Sha256"
        },
        "provider": {
          "const": "KRX_OPEN_API"
        },
        "ticker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "exchange": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "requestedDate": {
          "type": "string",
          "format": "date"
        },
        "tradingDate": {
          "type": "string",
          "format": "date"
        },
        "closePrice": {
          "type": "number"
        },
        "currency": {
          "const": "KRW"
        },
        "sourceApiId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sourcePayloadHash": {
          "$ref": "common.schema.json#/$defs/Sha256"
        }
      }
    },
    "DisplayRule": {
      "title": "DisplayRule",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string",
          "maxLength": 100
        },
        "scale": {
          "$ref": "common.schema.json#/$defs/DecimalString"
        },
        "roundingIncrement": {
          "$ref": "common.schema.json#/$defs/DecimalString"
        },
        "roundingMode": {
          "type": "string",
          "enum": [
            "half_up",
            "half_even",
            "floor",
            "ceiling",
            "truncate"
          ]
        },
        "pattern": {
          "type": "string",
          "maxLength": 500
        },
        "prefix": {
          "type": "string",
          "maxLength": 100
        },
        "suffix": {
          "type": "string",
          "maxLength": 100
        },
        "negativeStyle": {
          "type": "string",
          "enum": [
            "minus",
            "parentheses"
          ]
        },
        "blankDisplay": {
          "type": "string",
          "maxLength": 50
        }
      }
    },
    "ScalarBinding": {
      "title": "ScalarBinding",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "slotId",
        "kind",
        "valueType",
        "source",
        "verificationSources",
        "display",
        "status",
        "purpose",
        "semanticKey",
        "estimateType",
        "detectionConfidence",
        "reasonCodes",
        "review"
      ],
      "properties": {
        "bindingId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "slotId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "kind": {
          "const": "scalar"
        },
        "valueType": {
          "type": "string",
          "enum": [
            "decimal",
            "money",
            "percent",
            "integer",
            "date",
            "string",
            "boolean"
          ]
        },
        "source": {
          "$ref": "#/$defs/CellSource"
        },
        "verificationSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CellSource"
          }
        },
        "display": {
          "$ref": "#/$defs/DisplayRule"
        },
        "status": {
          "type": "string",
          "enum": [
            "suggested",
            "confirmed",
            "invalid"
          ]
        },
        "purpose": {
          "$ref": "#/$defs/BindingPurpose"
        },
        "semanticKey": {
          "$ref": "#/$defs/BindingSemanticKey"
        },
        "estimateType": {
          "$ref": "#/$defs/EstimateType"
        },
        "styleTemplateRef": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "detectionConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasonCodes": {
          "$ref": "#/$defs/ReasonCodes"
        },
        "review": {
          "$ref": "#/$defs/ReviewState"
        }
      }
    },
    "TableBinding": {
      "title": "TableBinding",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "slotId",
        "kind",
        "source",
        "rowKeyColumn",
        "columnHeaderRow",
        "expectedRows",
        "expectedColumns",
        "status",
        "purpose",
        "semanticKey",
        "estimateType",
        "detectionConfidence",
        "reasonCodes",
        "review"
      ],
      "properties": {
        "bindingId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "slotId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "kind": {
          "const": "table"
        },
        "source": {
          "$ref": "#/$defs/RangeSource"
        },
        "rowKeyColumn": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,3}$"
        },
        "columnHeaderRow": {
          "type": "integer",
          "minimum": 1
        },
        "expectedRows": {
          "type": "integer",
          "minimum": 1
        },
        "expectedColumns": {
          "type": "integer",
          "minimum": 1
        },
        "subtotalRows": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "unitRows": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "display": {
          "$ref": "#/$defs/DisplayRule"
        },
        "status": {
          "type": "string",
          "enum": [
            "suggested",
            "confirmed",
            "invalid"
          ]
        },
        "purpose": {
          "$ref": "#/$defs/BindingPurpose"
        },
        "semanticKey": {
          "$ref": "#/$defs/BindingSemanticKey"
        },
        "estimateType": {
          "$ref": "#/$defs/EstimateType"
        },
        "styleTemplateRef": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "detectionConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasonCodes": {
          "$ref": "#/$defs/ReasonCodes"
        },
        "review": {
          "$ref": "#/$defs/ReviewState"
        }
      }
    },
    "ChartSeries": {
      "title": "ChartSeries",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seriesId",
        "source",
        "axis",
        "role",
        "chartType",
        "estimateType"
      ],
      "properties": {
        "seriesId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "label": {
          "type": "string",
          "maxLength": 500
        },
        "source": {
          "$ref": "#/$defs/RangeSource"
        },
        "axis": {
          "type": "string",
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "actual",
            "forecast",
            "target",
            "band_upper",
            "band_lower",
            "benchmark"
          ]
        },
        "chartType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,99}$"
        },
        "estimateType": {
          "$ref": "#/$defs/EstimateType"
        }
      }
    },
    "ChartCandidateDefinition": {
      "title": "ChartCandidateDefinition",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categories",
        "series"
      ],
      "properties": {
        "categories": {
          "$ref": "#/$defs/RangeSource"
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ChartSeries"
          }
        },
        "chartTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,99}$"
          }
        }
      }
    },
    "ChartBinding": {
      "title": "ChartBinding",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "slotId",
        "kind",
        "categories",
        "series",
        "status",
        "purpose",
        "semanticKey",
        "estimateType",
        "detectionConfidence",
        "reasonCodes",
        "review"
      ],
      "properties": {
        "bindingId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "slotId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "kind": {
          "const": "chart"
        },
        "categories": {
          "$ref": "#/$defs/RangeSource"
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ChartSeries"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "suggested",
            "confirmed",
            "invalid"
          ]
        },
        "purpose": {
          "$ref": "#/$defs/BindingPurpose"
        },
        "semanticKey": {
          "$ref": "#/$defs/BindingSemanticKey"
        },
        "estimateType": {
          "$ref": "#/$defs/EstimateType"
        },
        "styleTemplateRef": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "detectionConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasonCodes": {
          "$ref": "#/$defs/ReasonCodes"
        },
        "review": {
          "$ref": "#/$defs/ReviewState"
        }
      }
    },
    "BindingPurpose": {
      "title": "BindingPurpose",
      "type": "string",
      "enum": [
        "workbook_input",
        "report_output"
      ]
    },
    "EstimateType": {
      "title": "BindingEstimateType",
      "type": "string",
      "enum": [
        "actual",
        "forecast",
        "mixed",
        "not_applicable"
      ]
    },
    "BindingSemanticKey": {
      "title": "BindingSemanticKey",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "period": {
          "type": "string",
          "maxLength": 100
        },
        "unit": {
          "type": "string",
          "maxLength": 100
        },
        "scope": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "ReasonCodes": {
      "title": "MappingReasonCodes",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,99}$"
      }
    },
    "ReviewState": {
      "title": "MappingReviewState",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unreviewed",
            "approved",
            "rejected",
            "needs_review"
          ]
        },
        "reviewedBy": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "reviewedAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "reasonCodes": {
          "$ref": "#/$defs/ReasonCodes"
        }
      }
    },
    "CompositeChartSeries": {
      "title": "CompositeChartSeries",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seriesId",
        "source",
        "axis",
        "role",
        "chartType",
        "estimateType"
      ],
      "properties": {
        "seriesId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "label": {
          "type": "string",
          "maxLength": 500
        },
        "source": {
          "$ref": "#/$defs/RangeSource"
        },
        "axis": {
          "type": "string",
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "actual",
            "forecast",
            "target",
            "band_upper",
            "band_lower",
            "benchmark"
          ]
        },
        "chartType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,99}$"
        },
        "estimateType": {
          "$ref": "#/$defs/EstimateType"
        }
      }
    },
    "CompositeChartBinding": {
      "title": "CompositeChartBinding",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "slotId",
        "kind",
        "purpose",
        "semanticKey",
        "categories",
        "series",
        "styleTemplateRef",
        "detectionConfidence",
        "reasonCodes",
        "status",
        "review"
      ],
      "properties": {
        "bindingId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "slotId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "kind": {
          "const": "composite_chart"
        },
        "purpose": {
          "$ref": "#/$defs/BindingPurpose"
        },
        "semanticKey": {
          "$ref": "#/$defs/BindingSemanticKey"
        },
        "categories": {
          "$ref": "#/$defs/RangeSource"
        },
        "series": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/CompositeChartSeries"
          }
        },
        "styleTemplateRef": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "detectionConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasonCodes": {
          "$ref": "#/$defs/ReasonCodes"
        },
        "status": {
          "type": "string",
          "enum": [
            "suggested",
            "confirmed",
            "invalid"
          ]
        },
        "review": {
          "$ref": "#/$defs/ReviewState"
        }
      }
    },
    "MarketDataBinding": {
      "title": "MarketDataBinding",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "slotId",
        "kind",
        "purpose",
        "semanticKey",
        "source",
        "display",
        "status",
        "review"
      ],
      "properties": {
        "bindingId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "slotId": {
          "$ref": "common.schema.json#/$defs/OpaqueId"
        },
        "kind": {
          "const": "market_data"
        },
        "purpose": {
          "$ref": "#/$defs/BindingPurpose"
        },
        "semanticKey": {
          "$ref": "#/$defs/BindingSemanticKey"
        },
        "source": {
          "$ref": "#/$defs/MarketDataSource"
        },
        "display": {
          "$ref": "#/$defs/DisplayRule"
        },
        "status": {
          "type": "string",
          "enum": [
            "suggested",
            "confirmed",
            "invalid"
          ]
        },
        "review": {
          "$ref": "#/$defs/ReviewState"
        }
      }
    },
    "GeneratedRangeSource": {
      "title": "GeneratedRangeSource",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheetId",
        "sheet",
        "range",
        "authority",
        "structureFingerprint",
        "generatorId",
        "sourceEvidenceIds"
