{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reflo.dev/worker/v1/common.schema.json",
  "title": "REFLO Worker Common Types v1",
  "description": "Shared scalar, identifier, version, coordinate, source locator, and tool types for REFLO worker contracts.",
  "$defs": {
    "OpaqueId": {
      "title": "OpaqueId",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "SchemaVersion": {
      "title": "SchemaVersion",
      "type": "string",
      "const": "1.0"
    },
    "CommandSchemaVersion": {
      "title": "CommandSchemaVersion",
      "type": "integer",
      "const": 1
    },
    "VersionNumber": {
      "title": "VersionNumber",
      "type": "integer",
      "minimum": 1
    },
    "Timestamp": {
      "title": "Timestamp",
      "type": "string",
      "format": "date-time"
    },
    "Date": {
      "title": "Date",
      "type": "string",
      "format": "date"
    },
    "Sha256": {
      "title": "Sha256",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "DecimalString": {
      "title": "DecimalString",
      "description": "Base-10 decimal serialized without exponent notation.",
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "NonEmptyString": {
      "title": "NonEmptyString",
      "type": "string",
      "minLength": 1
    },
    "JsonPointer": {
      "title": "JsonPointer",
      "type": "string",
      "pattern": "^(|/(?:[^~/]|~0|~1)*)$"
    },
    "PdfObjectRef": {
      "title": "PdfObjectRef",
      "type": "string",
      "pattern": "^[1-9][0-9]* [0-9]+ R$"
    },
    "BBox": {
      "title": "BBox",
      "description": "[x0, y0, x1, y1] in PDF points. Domain validation enforces x0 <= x1 and y0 <= y1.",
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "Point": {
      "title": "Point",
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "Quad": {
      "title": "Quad",
      "description": "Four points in PDF user-space order.",
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/Point"
        },
        {
          "$ref": "#/$defs/Point"
        },
        {
          "$ref": "#/$defs/Point"
        },
        {
          "$ref": "#/$defs/Point"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "Matrix": {
      "title": "Matrix",
      "description": "PDF affine matrix [a, b, c, d, e, f].",
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "ResourceVersionRef": {
      "title": "ResourceVersionRef",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "resourceVersionId",
        "version",
        "contentHash"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "resourceVersionId": {
          "$ref": "#/$defs/OpaqueId"
        },
        "version": {
          "$ref": "#/$defs/VersionNumber"
        },
        "contentHash": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "ToolDescriptor": {
      "title": "ToolDescriptor",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "buildId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "configurationHash": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "Warning": {
      "title": "Warning",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,99}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "objectIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/OpaqueId"
          }
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "PdfSourceLocator": {
      "title": "PdfSourceLocator",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "pageIndex",
        "coordinateSpace",
        "regions",
        "quoteExact",
        "quoteNormalized",
        "quoteSha256",
        "pageTextSha256"
      ],
      "properties": {
        "kind": {
          "const": "pdf"
        },
        "pageIndex": {
          "type": "integer",
          "minimum": 0
        },
        "pageLabel": {
          "type": "string",
          "maxLength": 100
        },
        "coordinateSpace": {
          "const": "pdf_points_cropbox"
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/BBox"
          }
        },
        "pageWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pageHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pageRotation": {
          "type": "integer",
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "quoteExact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "quoteNormalized": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "quoteSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "charStart": {
          "type": "integer",
          "minimum": 0
        },
        "charEnd": {
          "type": "integer",
          "minimum": 0
        },
        "pageTextSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "pageRenderSha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "HtmlSourceLocator": {
      "title": "HtmlSourceLocator",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "requestedUrl",
        "finalUrl",
        "capturedAt",
        "quoteExact",
        "quoteNormalized",
        "quoteSha256",
        "contentSha256"
      ],
      "properties": {
        "kind": {
          "const": "html"
        },
        "requestedUrl": {
          "type": "string",
          "format": "uri"
        },
        "finalUrl": {
          "type": "string",
          "format": "uri"
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri"
        },
        "capturedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "quoteExact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "quoteNormalized": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "quoteSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "prefix": {
          "type": "string",
          "maxLength": 1000
        },
        "suffix": {
          "type": "string",
          "maxLength": 1000
        },
        "charStart": {
          "type": "integer",
          "minimum": 0
        },
        "charEnd": {
          "type": "integer",
          "minimum": 0
        },
        "cssSelector": {
          "type": "string",
          "maxLength": 2000
        },
        "xpath": {
          "type": "string",
          "maxLength": 2000
        },
        "textFragment": {
          "type": "string",
          "maxLength": 4000
        },
        "sectionHeading": {
          "type": "string",
          "maxLength": 1000
        },
        "contentSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "parserVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "StructuredSourceLocator": {
      "title": "StructuredSourceLocator",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sourceType",
        "documentId",
        "requestCanonical",
        "responseSha256",
        "pointer"
      ],
      "properties": {
        "kind": {
          "const": "structured"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "DART",
            "KRX",
            "ECOS",
            "FNGUIDE_CONSENSUS",
            "OTHER_OFFICIAL_API"
          ]
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "requestCanonical": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "responseSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "pointer": {
          "$ref": "#/$defs/JsonPointer"
        },
        "entityCode": {
          "type": "string",
          "maxLength": 100
        },
        "period": {
          "type": "string",
          "maxLength": 100
        },
        "unit": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "ExcelSourceLocator": {
      "title": "ExcelSourceLocator",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "workbookVersionId",
        "workbookHash",
        "sheetName",
        "sheetId",
        "address",
        "calculationVersion"
      ],
      "properties": {
        "kind": {
          "const": "excel"
        },
        "workbookVersionId": {
          "$ref": "#/$defs/OpaqueId"
        },
        "workbookHash": {
          "$ref": "#/$defs/Sha256"
        },
        "sheetName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "address": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*(?::[A-Za-z]{1,3}[1-9][0-9]*)?$"
        },
        "rawValue": {},
        "formula": {
          "type": "string",
          "maxLength": 10000
        },
        "numberFormat": {
          "type": "string",
          "maxLength": 500
        },
        "calculationVersion": {
          "$ref": "#/$defs/VersionNumber"
        },
        "dependencyArtifactId": {
          "$ref": "#/$defs/OpaqueId"
        }
      }
    },
    "SourceLocator": {
      "title": "SourceLocator",
      "oneOf": [
        {
          "$ref": "#/$defs/PdfSourceLocator"
        },
        {
          "$ref": "#/$defs/HtmlSourceLocator"
        },
        {
          "$ref": "#/$defs/StructuredSourceLocator"
        },
        {
          "$ref": "#/$defs/ExcelSourceLocator"
        }
      ]
    }
  }
}
